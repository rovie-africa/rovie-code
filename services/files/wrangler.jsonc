{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rovie-code-files",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": true,
  "env": {
    "dev": {
      "name": "rovie-code-dev-files",
      "workers_dev": true,
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "rovie-code-dev-files" }],
    },
    "production": {
      "name": "rovie-code-production-files",
      "workers_dev": true,
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "rovie-code-production-files" }],
    },
  },
}
