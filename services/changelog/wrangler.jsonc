{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rovie-code-changelog",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
  },
  "routes": [
    {
      "pattern": "rovie.africa/changelog",
      "zone_name": "rovie.africa",
    },
    {
      "pattern": "rovie.africa/changelog/*",
      "zone_name": "rovie.africa",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
